# R-IoTSys Environment Variables Configuration Template
NODE_ENV=production

# Database (PostgreSQL)
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=riotsys_db
DATABASE_URL=postgresql://your_postgres_user:your_secure_postgres_password@localhost:5432/riotsys_db?schema=public

# Initial Super Admin Seed (Used on first database initialization)
INITIAL_ADMIN_EMAIL=admin@your-domain.com
INITIAL_ADMIN_PASSWORD=your_strong_initial_password

# Security & Authentication
JWT_SECRET=generate_a_random_32_character_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Domain & CORS Configuration
CORS_ORIGIN=http://localhost:5173,https://your-domain.com
PUBLIC_URL=https://your-domain.com

# Email Notification Service (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM="R-IoTSys <notifications@your-domain.com>"
CONTACT_RECEIVER_EMAIL=contact@your-domain.com

# File Storage
UPLOAD_DIR=./uploads
