# R-IoTSys Environment Variables Configuration Example
NODE_ENV=production

# Database (PostgreSQL)
POSTGRES_USER=riotsys_user
POSTGRES_PASSWORD=riotsys_secure_password_2026
POSTGRES_DB=riotsys_db
DATABASE_URL=postgresql://riotsys_user:riotsys_secure_password_2026@localhost:5432/riotsys_db?schema=public

# Security & Authentication
JWT_SECRET=riotsys_super_secret_jwt_key_9928174625_production_engineering
JWT_EXPIRES_IN=7d

# Domain & CORS
CORS_ORIGIN=http://localhost:5173,http://51.210.40.27,https://r-iotsys.tn,https://www.r-iotsys.tn
