PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://your_postgres_user:your_secure_postgres_password@localhost:5432/riotsys_db?schema=public"
JWT_SECRET="generate_a_random_32_character_jwt_secret_key_here"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:5173,https://your-domain.com"
UPLOAD_DIR="./uploads"
PUBLIC_URL="http://localhost:5000"

# Initial Super Admin Setup (Used during prisma db seed)
INITIAL_ADMIN_EMAIL="admin@your-domain.com"
INITIAL_ADMIN_PASSWORD="your_strong_initial_password"

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="R-IoTSys <notifications@your-domain.com>"
CONTACT_RECEIVER_EMAIL="contact@your-domain.com"
